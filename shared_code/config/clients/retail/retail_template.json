  "prompts": {
    "system_greeting": "Hi, I’m {assistant} with {brand}. Before we get started, can I take your name?",
    "ask_intent_with_name": "How can I help you today, {name}?",
    "ask_intent_retry_giveup": "How can I help you today?",
    "ask_name_retry": "Sorry, I didn't catch your name. Could you say it again?",
    "intent_fallback": "Sorry, I didn’t quite catch that. How can I help you today?",
    "order_tracking_ask_order": "Sure, I can help with that. Could you tell me your order number?",
    "order_tracking_ask_email": "Thanks. What email address did you use when placing the order?",
    "order_tracking_ask_postcode": "And finally, could you confirm your delivery postcode?",
    "returns_ask_item": "No problem. Which item would you like to return?",
    "returns_ask_reason": "Thanks. What's the reason for the return?",
    "returns_ask_condition": "Is the item unused and in its original packaging?",
    "refunds_ask_item": "Which item would you like a refund for?",
    "refunds_ask_reason": "Could you tell me the reason you're requesting a refund?",
    "warranty_ask_purchase_date": "Do you know roughly when the item was purchased?",
    "warranty_ask_issue": "Could you describe the issue you're experiencing?",
    "warranty_expired_redirect": "Thanks. It looks like the item is outside the warranty period. I can still help with next steps.",
    "delivery_issue_ask_tracking": "Have you received any tracking updates?",
    "delivery_issue_ask_card": "Has the courier left a delivery card?",
    "delivery_issue_ask_address": "Is the delivery address on your order correct?",
    "product_support_ask_product": "Which product do you need help with?",
    "product_support_ask_issue": "Could you describe the issue you're having?",
    "product_support_ask_steps": "Have you tried any troubleshooting steps so far?",
    "account_ask_email": "What's the email address on your account?",
    "account_ask_issue": "What issue are you having with your account?",
    "payment_ask_method": "Which payment method were you using?",
    "payment_ask_error": "Did you receive any error messages?",
    "first_response_greeting": "Hi, I’m {assistant} with {brand}. Before we get started, can I take your name?",
    "first_response_ask_intent": "How can I help you today, {name}?"
  },
