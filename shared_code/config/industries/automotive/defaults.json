{
  "industry": "automotive",
  "default_tone": "friendly and professional",
  "default_brand_name": "Your Automotive Brand",
  "intents": [
    "first_response",
    "warranty",
    "service",
    "sales",
    "finance",
    "general"
  ],
  "start_of_call": {
    "ask_name": true,
    "ask_callback_number": true,
    "ask_reason_for_call": true
  },
  "warranty_rules": {
    "default_warranty_months": 36
  },
  "service_rules": {
    "collect_registration": true,
    "collect_mileage": true
  },
  "workflow_behavior": {
    "first_response": {
      "question_mode": "single_turn"
    },
    "warranty": {
      "question_mode": "single_turn",
      "max_follow_ups": 0
    },
    "service": {
      "question_mode": "multi_turn",
      "max_follow_ups": 3
    },
    "sales": {
      "question_mode": "multi_turn",
      "max_follow_ups": 5
    }
  },
  "prompts": {
    "first_response_greeting": "Hi, I’m {assistant} with {brand}. Before we get into the details, can I take your name?",
    "first_response_ask_intent": "How can I help you today, {name}?",
    "ask_intent_retry_giveup": "How can I help you today?",
    "ask_name_retry": "Sorry, I didn't catch your name. Could you say it again?",
    "intent_fallback": "Sorry, I didn’t quite catch that. How can I help you today?",
    "warranty_valid_ask_issue": "Thanks. It looks like the vehicle is within the warranty period. Could you describe the issue you're experiencing?",
    "warranty_ask_purchase_date": "Do you know roughly when the vehicle was purchased?",
    "warranty_expired_redirect": "Thanks for that. It looks like the vehicle is outside the manufacturer warranty. You may want to contact an independent garage. Is there anything else?",
    "warranty_expired_capture": "Thanks for that. Although the vehicle is outside warranty, I can still take some details. Could you describe the issue?",
    "intent_not_recognized": "Sorry, I’m not able to help with that. Is there anything else I can assist you with?",
    "sales_start": "Great! I'd be happy to help you with that. What are you interested in?",
    "sales_ask_vehicle_type": "What type of vehicle are you looking for? For example, a sedan, SUV, or truck?",
    "sales_ask_budget": "Do you have a budget in mind?",
    "sales_ask_contact": "Perfect! I'd like to have one of our sales specialists reach out to you. What's the best phone number to contact you?",
    "sales_confirm": "Thanks {name}! I've captured all your details. One of our sales team will be in touch shortly to discuss your options. Is there anything else I can help with today?"
  },
  "workflows": {
    "first_response": {
      "nodes": [
        {
          "id": "fr1",
          "type": "input",
          "data": {
            "label": "Greeting & Name",
            "promptKey": "first_response_greeting",
            "captureVariable": "customer_name"
          },
          "position": {
            "x": 250,
            "y": 0
          }
        },
        {
          "id": "fr3",
          "type": "default",
          "data": {
            "label": "Ask Intent",
            "promptKey": "first_response_ask_intent"
          },
          "position": {
            "x": 250,
            "y": 100
          }
        },
        {
          "id": "fr4",
          "type": "action",
          "data": {
            "label": "Detect Intent",
            "actionType": "detect_intent"
          },
          "position": {
            "x": 250,
            "y": 200
          }
        }
      ],
      "edges": [
        {
          "id": "efr1-3",
          "source": "fr1",
          "target": "fr3"
        },
        {
          "id": "efr3-4",
          "source": "fr3",
          "target": "fr4"
        }
      ]
    },
    "sales": {
      "nodes": [
        {
          "id": "s1",
          "type": "default",
          "data": {
            "label": "Sales Start",
            "promptKey": "sales_start"
          },
          "position": {
            "x": 250,
            "y": 0
          }
        },
        {
          "id": "s2",
          "type": "default",
          "data": {
            "label": "Ask Vehicle Type",
            "promptKey": "sales_ask_vehicle_type",
            "captureVariable": "vehicle_type"
          },
          "position": {
            "x": 250,
            "y": 100
          }
        },
        {
          "id": "s3",
          "type": "default",
          "data": {
            "label": "Ask Budget",
            "promptKey": "sales_ask_budget",
            "captureVariable": "budget"
          },
          "position": {
            "x": 250,
            "y": 200
          }
        },
        {
          "id": "s4",
          "type": "default",
          "data": {
            "label": "Ask Contact Number",
            "promptKey": "sales_ask_contact",
            "captureVariable": "contact_number"
          },
          "position": {
            "x": 250,
            "y": 300
          }
        },
        {
          "id": "s5",
          "type": "action",
          "data": {
            "label": "Send Lead Email",
            "actionType": "email",
            "actionConfig": {
              "to": "sales@company.com",
              "subject": "New Sales Lead: {customer_name}"
            }
          },
          "position": {
            "x": 250,
            "y": 400
          }
        },
        {
          "id": "s6",
          "type": "default",
          "data": {
            "label": "Confirm",
            "promptKey": "sales_confirm"
          },
          "position": {
            "x": 250,
            "y": 500
          }
        }
      ],
      "edges": [
        {
          "id": "es1-2",
          "source": "s1",
          "target": "s2"
        },
        {
          "id": "es2-3",
          "source": "s2",
          "target": "s3"
        },
        {
          "id": "es3-4",
          "source": "s3",
          "target": "s4"
        },
        {
          "id": "es4-5",
          "source": "s4",
          "target": "s5"
        },
        {
          "id": "es5-6",
          "source": "s5",
          "target": "s6"
        }
      ]
    },
    "warranty": {
      "nodes": [
        {
          "id": "1",
          "type": "input",
          "data": {
            "label": "Start Warranty Check"
          },
          "position": {
            "x": 250,
            "y": 0
          }
        },
        {
          "id": "2",
          "data": {
            "label": "Check Purchase Date"
          },
          "position": {
            "x": 250,
            "y": 100
          }
        },
        {
          "id": "3",
          "data": {
            "label": "Calculate Status"
          },
          "position": {
            "x": 250,
            "y": 200
          }
        },
        {
          "id": "4",
          "data": {
            "label": "In Warranty: Ask Issue"
          },
          "position": {
            "x": 100,
            "y": 300
          }
        },
        {
          "id": "5",
          "data": {
            "label": "Out of Warranty: Redirect"
          },
          "position": {
            "x": 400,
            "y": 300
          }
        }
      ],
      "edges": [
        {
          "id": "e1-2",
          "source": "1",
          "target": "2"
        },
        {
          "id": "e2-3",
          "source": "2",
          "target": "3"
        },
        {
          "id": "e3-4",
          "source": "3",
          "target": "4",
          "label": "< 36 months"
        },
        {
          "id": "e3-5",
          "source": "3",
          "target": "5",
          "label": "> 36 months"
        }
      ]
    }
  }
}
