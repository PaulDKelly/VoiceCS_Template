location: uksouth
properties:
  configuration:
    ingress:
      external: true
      targetPort: 3000
      transport: auto
    registries:
    - server: ACR_LOGIN_SERVER_PLACEHOLDER
      username: ACR_NAME_PLACEHOLDER
      passwordSecretRef: acr-password
  template:
    containers:
    - image: IMAGE_URI_PLACEHOLDER
      name: workflow-manager
      env:
      - name: APP_CONFIG_PATH
        value: /app/config
      - name: NEXTAUTH_SECRET
        value: NEXTAUTH_SECRET_PLACEHOLDER
      - name: NEXTAUTH_URL
        value: NEXTAUTH_URL_PLACEHOLDER
      - name: TRUST_HOST
        value: "true"
      - name: ELEVENLABS_API_KEY
        secretRef: elevenlabs-key
      - name: AZURE_SPEECH_KEY
        secretRef: speech-key
      - name: AZURE_SPEECH_KEY_HD
        secretRef: speech-key-hd
      - name: AZURE_SPEECH_REGION
        value: AZURE_SPEECH_REGION_PLACEHOLDER
      - name: AZURE_SPEECH_REGION_HD
        value: AZURE_SPEECH_REGION_HD_PLACEHOLDER
      - name: TWILIO_ACCOUNT_SID
        secretRef: twilio-account-sid
      - name: TWILIO_AUTH_TOKEN
        secretRef: twilio-auth-token
      volumeMounts:
      - mountPath: /app/config
        volumeName: config-volume
    volumes:
    - name: config-volume
      storageName: config-share
      storageType: AzureFile
