{
  "client_id": "autonova",
  "brand_name": "AutoNova",
  "assistant_name": "Nova",
  "agent_name": "Nova",
  "opening_hours": "Monday to Saturday, 8am to 6pm",
  "brand_phone": "01234 567890",
  "tone": "friendly, concise, helpful",
  "voice_name": "en-GB-LibbyNeural",
  "elevenlabs_voice_id": "MzqUf1HbJ8UmQ0wUsx2p",
  "language": "en-GB",
  "industry": "automotive",
  "intents": [
    "warranty",
    "service",
    "sales",
    "finance",
    "general"
  ],
  "warranty_period_months": 6,
  "enable_warranty": true,
  "enable_sales": false,
  "enable_service": true,
  "enable_finance": false,
  "booking_config": {
    "notification_email": "pauldkelly@outlook.com",
    "email_subject_prefix": "New Service Booking:"
  },
  "warranty_completion": {
    "mode": "handoff",
    "target_intent": "service",
    "transition_message": "I've captured all the details. I'll now hand you over to our servicing team to get this booked in."
  },
  "intent_routing_rules": {
    "warranty": {
      "keywords": [
        "problem",
        "issue",
        "fault",
        "broken",
        "not working",
        "noise",
        "rattle"
      ],
      "enabled": true
    },
    "service": {
      "keywords": [
        "service",
        "servicing",
        "maintenance"
      ],
      "enabled": true
    },
    "sales": {
      "keywords": [
        "buy",
        "purchase",
        "test drive"
      ],
      "enabled": false
    },
    "finance": {
      "keywords": [
        "finance",
        "loan",
        "monthly payment"
      ],
      "enabled": false
    },
    "general": {
      "keywords": [],
      "enabled": true
    },
    "priority": [
      "warranty",
      "service",
      "sales",
      "finance",
      "general"
    ],
    "fallback_to_llm": true
  },
  "prompts": {
    "service_ask_issue": "Could you describe the problem you're experiencing?",
    "service_ask_name": "Could I take your full name for the booking?",
    "service_ask_phone": "Could you please provide the best telephone number to contact you on?",
    "service_ask_postcode": "Could you tell me the postcode for the address?",
    "service_ask_house_number": "Thanks. What's the house number or name?",
    "service_confirm_address": "Thanks. I have the address as: {address}. Is that correct?",
    "system_greeting": "Hi, I’m {assistant} with {brand}. Before we get into the details, can I take your name?",
    "ask_intent_with_name": "How can I help you today, {name}?",
    "ask_intent_retry_giveup": "How can I help you today?",
    "ask_name_retry": "Sorry, I didn't catch your name. Could you say it again?",
    "intent_fallback": "Sorry, I didn’t quite catch that. How can I help you today?",
    "warranty_valid_ask_issue": "Thanks. It looks like the vehicle is within the warranty period. Could you describe the issue you're experiencing?",
    "warranty_ask_purchase_date": "Do you know roughly when the vehicle was purchased?",
    "warranty_expired_redirect": "Thanks for that. It looks like the vehicle is outside the manufacturer warranty. You may want to contact an independent garage. Is there anything else?",
    "warranty_expired_capture": "Thanks for that. Although the vehicle is outside warranty, I can still take some details. Could you describe the issue?"
  },
